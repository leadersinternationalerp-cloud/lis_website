# ─────────────────────────────────────────────────────────────
# Copy to .env.local for local work, and paste the same values
# into Vercel → Settings → Environment Variables.
# Every variable is OPTIONAL: the site runs fully without them.
# ─────────────────────────────────────────────────────────────

# Canonical domain (used for sitemap, robots, social share links)
NEXT_PUBLIC_SITE_URL=https://www.leadersinternationalschool.ac.tz

# ── Optional: Sanity (photos, documents, news, applications) ──
# 1) npm i -D sanity (already in this repo)  2) npx sanity@latest init --no-install
# 3) paste the project id here, then run: npm run studio
NEXT_PUBLIC_SANITY_PROJECT_ID=x9pcz7mh
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19
SANITY_STUDIO_TITLE=LIS — School content

# Only needed so /apply and /contact can SAVE into Sanity. Create a token with
# "Editor" permission at https://sanity.io/manage → API → Tokens.
SANITY_API_WRITE_TOKEN=

# Only needed for the manual cache-flush endpoint /api/revalidate
REVALIDATE_SECRET=
