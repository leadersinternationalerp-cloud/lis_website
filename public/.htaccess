# Leaders International School — cPanel Apache / LiteSpeed Configuration
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Block direct web access to form submission logs
  RewriteRule ^submissions(/.*)?$ - [F,L]

  # Route /api/submit to the cPanel PHP form mailer when running static export
  RewriteRule ^api/submit/?$ /api/submit.php [L,QSA]
</IfModule>

# Custom 404 page generated by Next.js
ErrorDocument 404 /404.html

# Cache static assets for fast repeat visits
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType application/pdf "access plus 7 days"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
